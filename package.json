{
  "name": "study-studio",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "DiaSy24",
  "description": "StudyLab AI — Antigravity CLI (agy) destekli etkileşimli ders çalışma uygulaması",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "npm run build && npm run build:electron",
    "dev:electron": "npm run build:electron && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "dist:dir": "npm run build:desktop && electron-builder --win --dir --publish never",
    "release:win": "node scripts/release-win.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx-preview": "^0.4.1",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "multer": "^2.0.0",
    "pdfjs-dist": "^5.2.133",
    "pptx-preview": "^1.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "uuid": "^11.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/katex": "^0.16.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.176.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
